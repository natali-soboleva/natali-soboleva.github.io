---
// Общий шаблон: <head>, шапка, подвал.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../lib/content';

interface Props {
  title?: string;
  notFound?: boolean;
}

const { title, notFound = false } = Astro.props;
const { hero, settings } = content;
const pageTitle = title ? `${title} — ${hero.name}` : `${hero.name} — ${hero.role}`;
const description = `${hero.name}, ${hero.role}. ${content.contacts.gymName}, ${content.contacts.gymAddress}. Персональные, сплит- и групповые тренировки.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
---

<html lang="ru" class:list={[{ bw: settings.blackWhitePhotos }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(settings.hideFromSearch || notFound) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F1ECF6" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    <link rel="preload" href="/fonts/cormorant-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Превью ссылки в мессенджерах и соцсетях -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col font-sans font-light antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:px-3 focus:py-2"
    >
      Перейти к содержимому
    </a>
    {
      settings.draftNotice && settings.draftNoticeText && (
        <div role="note" class="bg-plum-dark px-4 py-2 text-center text-xs leading-snug font-normal text-paper sm:text-sm">
          {settings.draftNoticeText}
        </div>
      )
    }
    <Header />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
