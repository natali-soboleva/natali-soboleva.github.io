---
// Запись и контакты: девиз на фото, кнопка в Instagram Direct, где тренирую
import { Image } from 'astro:assets';
import Button from './Button.astro';
import SectionTitle from './SectionTitle.astro';
import Sparkle from './Sparkle.astro';
import { content, instagramDirect, instagramProfile, photo } from '../lib/content';

const { booking, contacts, hero } = content;
const img = photo(booking.quotePhoto);
---

<section id="contacts" class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-2 md:gap-16">
    {
      img && (
        <figure class="relative mx-auto w-full max-w-sm">
          <Image
            src={img}
            alt={hero.name}
            widths={[400, 640, 800]}
            sizes="(min-width: 768px) 384px, 90vw"
            class="photo aspect-[3/4] w-full rounded-b-full object-cover"
          />
          <Sparkle class="absolute -top-4 -right-2 w-8" />
        </figure>
      )
    }

    <div class="text-center md:text-left">
      <SectionTitle title={booking.title} subtitle={booking.subtitle} align="auto" />
      <p class="-mt-4 leading-relaxed">{booking.text}</p>
      <div class="mt-8">
        <Button href={instagramDirect(contacts.instagram)} external class="w-full max-w-xs">{booking.button}</Button>
      </div>

      <div class="mx-auto mt-14 h-px w-16 bg-line md:mx-0" aria-hidden="true" />

      <h2 class="mt-10 font-display text-3xl font-light tracking-[0.06em] uppercase">{contacts.title}</h2>
      <dl class="mt-6 space-y-5">
        <div>
          <dt class="text-xs tracking-[0.16em] text-muted uppercase">Instagram</dt>
          <dd class="mt-1">
            <a href={instagramProfile(contacts.instagram)} target="_blank" rel="noopener" class="font-display text-2xl underline decoration-line underline-offset-4 hover:decoration-ink">
              @{contacts.instagram}
            </a>
          </dd>
        </div>
        {
          contacts.gymName && (
            <div>
              <dt class="text-xs tracking-[0.16em] text-muted uppercase">Где тренирую</dt>
              <dd class="mt-1">
                {contacts.gymInstagram ? (
                  <a href={instagramProfile(contacts.gymInstagram)} target="_blank" rel="noopener" class="underline decoration-line underline-offset-4 hover:decoration-ink">
                    {contacts.gymName}
                  </a>
                ) : (
                  contacts.gymName
                )}
                {contacts.gymAddress && <span class="block text-muted">{contacts.gymAddress}</span>}
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </div>
</section>
