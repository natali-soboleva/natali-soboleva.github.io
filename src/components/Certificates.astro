---
// Сертификаты и дипломы: сетка фото (включается в админке, когда фото добавлены)
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import { content, photo } from '../lib/content';

const { certificates } = content;
const imgs = (certificates.photos as string[]).map(photo).filter((p) => p !== undefined);
---

{
  imgs.length > 0 && (
    <section id="certificates" class="bg-paper px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <SectionTitle title={certificates.title} subtitle={certificates.subtitle} />
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5">
          {imgs.map((img, i) => (
            <a href={img.src} target="_blank" rel="noopener" class="block border border-line bg-lilac p-2">
              <Image src={img} alt={`Сертификат ${i + 1}`} widths={[320, 640]} sizes="(min-width: 640px) 300px, 45vw" class="w-full" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
