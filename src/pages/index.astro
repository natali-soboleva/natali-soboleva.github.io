---
// Одна страница: блоки идут сверху вниз. Включение/выключение блоков — в админке (поле «Показывать»).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Directions from '../components/Directions.astro';
import Process from '../components/Process.astro';
import Video from '../components/Video.astro';
import Online from '../components/Online.astro';
import Certificates from '../components/Certificates.astro';
import Contacts from '../components/Contacts.astro';
import { content } from '../lib/content';

const { about, directions, process, video, online, certificates } = content;
---

<BaseLayout>
  <Hero />
  {about.show && <About />}
  {directions.show && <Directions />}
  {process.show && <Process />}
  {video.show && <Video />}
  {online.show && <Online />}
  {certificates.show && <Certificates />}
  <Contacts />
</BaseLayout>
