# Заголовки для Cloudflare Pages

# X-Robots-Tag: пока сайт черновик, поисковики не берут ни страницу, ни фото, ни видео.
# Убрать эту строку вместе с галочкой «Скрыть сайт от поисковиков» (см. HANDOFF.md)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, noimageindex
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Файлы сборки: в имени есть отпечаток содержимого — кэш «навсегда»
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Видео: имена без отпечатка — кэш на сутки
/video/*
  Cache-Control: public, max-age=86400

# Страница: каждый раз сверяться с сервером, чтобы правки из админки были видны сразу
/
  Cache-Control: public, max-age=0, must-revalidate
